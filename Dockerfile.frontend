FROM node:22-alpine AS builder

WORKDIR /app

COPY package.frontend.json ./package.json

RUN npm install --legacy-peer-deps || npm install --legacy-peer-deps

COPY src ./src
COPY public ./public
COPY index.html ./
COPY vite.config.js ./
COPY tsconfig.json ./

ENV VITE_BACKEND_URL=__VITE_BACKEND_URL__
RUN npm run build

# nginx serves the static build in a few MB, where the `serve` package needed
# a whole Node.js process.
FROM nginx:stable-alpine AS runner

# One worker is plenty for static files; the default starts one per CPU core.
RUN sed -i 's/^worker_processes .*/worker_processes 1;/' /etc/nginx/nginx.conf \
 && rm /etc/nginx/conf.d/default.conf

COPY nginx.frontend.conf /etc/nginx/frontend.conf.template
COPY --from=builder /app/build /usr/share/nginx/html

EXPOSE ${FRONTEND_PORT:-5173}

CMD ["sh", "-c", "BACKEND=\"${VITE_BACKEND_URL:-${BACKEND_URL:-http://localhost:8080}}\"; grep -rl '__VITE_BACKEND_URL__' /usr/share/nginx/html 2>/dev/null | xargs -r sed -i \"s|__VITE_BACKEND_URL__|${BACKEND}|g\"; sed \"s|__FRONTEND_PORT__|${FRONTEND_PORT:-5173}|g\" /etc/nginx/frontend.conf.template > /etc/nginx/conf.d/frontend.conf; exec nginx -g 'daemon off;'"]
